{
  "name": "ai-risk-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "triggers": {
    "crons": ["25 12 * * MON-FRI", "15 * * * MON-FRI", "40 12 * * MON"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "risk-monitor-db",
    "database_id": "REPLACE_WITH_EXISTING_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "APP_ORIGIN": "https://YOUR-USERNAME.github.io",
    "SEC_USER_AGENT": "AI Risk Monitor YOUR-NAME YOUR-CONTACT-EMAIL",
    "CHECKIN_MODE": "daily",
    "SEC_SYMBOLS": "MSFT,AMZN,GOOGL,META,NVDA,AVGO,ORCL,CRWV"
  }
}
